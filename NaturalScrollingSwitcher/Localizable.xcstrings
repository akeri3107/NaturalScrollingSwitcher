    "about.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About Natural Scrolling Switcher"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Natural Scrolling Switcher 정보"
          }
        }
      }
    },
    "about.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS utility that automatically switches Natural Scrolling depending on the connected input device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 입력 장치에 따라 자연스러운 스크롤을 자동으로 전환하는 macOS 유틸리티입니다."
          }
        }
      }
    },
    "about.creator": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created by Akeri"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제작: Akeri"
          }
        }
      }
    },
    "button.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "devices.priorityExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS uses one scroll direction for all devices. The last edited connected mouse takes priority."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 모든 장치에 대해 하나의 스크롤 방향만을 사용합니다. 연결된 마우스 중 마지막으로 설정이 변경된 마우스의 방향을 따릅니다."
          }
        }
      }
    },
    "devices.disconnectExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it disconnects, the latest connected mouse takes over. Auto follows external mouse presence."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 마우스의 연결이 해제되면, 남아 있는 마우스 중 가장 최근에 연결된 마우스의 설정값을 적용합니다. 자동 모드는 외장 마우스의 연결 여부를 따릅니다."
          }
        }
      }
    },
    "devices.showInternal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show internal devices"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 장치 표시"
          }
        }
      }
    },
    "devices.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved or connected external devices."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되었거나 연결된 외장 마우스가 없습니다."
          }
        }
      }
    },
