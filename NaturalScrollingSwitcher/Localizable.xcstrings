    "devices.identity.ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambiguous identity · automatic matching is blocked. Saved policy is retained."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치 식별이 불분명함 · 자동 매칭이 차단되었습니다. 저장된 설정은 유지됩니다."
          }
        }
      }
    },
    "devices.identity.highConfidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High confidence · serial or unique identifier"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높은 신뢰도 · 일련번호 또는 고유 식별자로 식별됨"
          }
        }
      }
    },
    "devices.identity.mediumConfidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium confidence · model fingerprint. Identical devices may be indistinguishable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중간 신뢰도 · 모델 정보로 식별됨. 동일한 장치는 구분되지 않을 수 있습니다."
          }
        }
      }
    },
    "devices.identity.sessionOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session only · saved device remains listed, but cannot be matched automatically after disconnect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 세션에서만 식별 가능 · 저장된 장치는 목록에 유지되지만 연결 해제 후 자동으로 다시 매칭할 수 없습니다."
          }
        }
      }
    },
    "devices.error.read": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved devices could not be read. Existing data has been preserved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 장치 정보를 읽을 수 없습니다. 기존 데이터는 그대로 유지되었습니다."
          }
        }
      }
    },
    "devices.error.write": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved devices could not be written."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치 정보를 저장할 수 없습니다."
          }
        }
      }
    },
